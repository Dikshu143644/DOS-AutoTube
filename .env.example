# Copy to .env and fill in. Never commit .env.
# Script writing (either one)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
IMAGE_MODEL=gpt-image-1

# Narration
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVENLABS_MODEL=eleven_multilingual_v2

# YouTube Data API (OAuth desktop client from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=.secrets/client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json
